# py-lazer-server configuration

# Server settings
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SERVER_MODE=development

# Database
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./osu.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/osu

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Security - CHANGE IN PRODUCTION
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 Client settings
OAUTH_CLIENT_ID=5
OAUTH_CLIENT_SECRET=change-me

# External URLs
API_BASE_URL=http://localhost:8000
WEBSITE_URL=http://localhost:8000

# File storage paths
BEATMAPS_PATH=./data/beatmaps
REPLAYS_PATH=./data/replays
AVATARS_PATH=./data/avatars

# Rate limiting
RATE_LIMIT_REQUESTS=1200
RATE_LIMIT_WINDOW_SECONDS=600

# Beatmap mirror settings
# When true, uses internal mirror (requires IP whitelist for some endpoints)
# When false, uses official osu! API directly (requires osu_api credentials)
USE_BEATMAP_MIRROR=true
BEATMAP_MIRROR_URL=https://beatmaps.akatsuki.gg

# Official osu! API v2 credentials (required when USE_BEATMAP_MIRROR=false)
# Create an OAuth application at: https://osu.ppy.sh/home/account/edit#oauth
OSU_API_CLIENT_ID=
OSU_API_CLIENT_SECRET=

# Replays and beatmap files go to object storage (app/services/storage.py). Backends are tried in this order:
#   1. S3          - used when S3_BUCKET is set (S3_ENDPOINT_URL empty = AWS; set it for another S3-compatible service)
#   2. SeaweedFS   - used when SEAWEEDFS_ENDPOINT_URL is set (docker compose sets it for the bundled container)
#   3. local disk  - BEATMAPS_PATH / REPLAYS_PATH, always the last resort (and the only store if nothing else is set)
# A write goes to the first backend that accepts it; a read asks them in turn. BEATMAPS_PATH also stays as a cache,
# because the PP engine needs files on disk.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# SEAWEEDFS_ENDPOINT_URL=http://localhost:8333
# SEAWEEDFS_BUCKET=akatsuki
# SEAWEEDFS_ACCESS_KEY=
# SEAWEEDFS_SECRET_KEY=
# STORAGE_TIMEOUT_SECONDS=5

# Realtime multiplayer runs as a separate Go service (./multiplayer).
# INTERNAL_API_KEY enables /internal/* (the Go service stores rooms through it). Use a long random value,
# the same one as the Go service's INTERNAL_API_KEY. Empty = internal API disabled.
INTERNAL_API_KEY=
# Set to true once the Go service serves /multiplayer, so this process stops serving it.
USE_EXTERNAL_MULTIPLAYER=false
